# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway…)
DATABASE_URL="postgresql://user:password@host:5432/autolab?sslmode=require"
# IANA timezone of the shop. All slots are generated in this zone.
SHOP_TIMEZONE="America/Los_Angeles"
# Public URL of the site, no trailing slash. Used in Stripe redirects and emails.
NEXT_PUBLIC_SITE_URL="https://autolab.example"

# Admin login. Generate the hash with:  npm run hash-password -- "a-long-password"
ADMIN_EMAIL="owner@autolab.example"
ADMIN_PASSWORD_HASH_B64=""
# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=""

# Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""

# ── Payments (required in production — booking is refused without it) ──────
STRIPE_SECRET_KEY="sk_live_..."
# Stripe Dashboard → Developers → Webhooks → endpoint https://<site>/api/stripe/webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email (Resend). Without a key, emails are only logged. ──────────────────
RESEND_API_KEY=""
EMAIL_FROM="Auto Lab <bookings@autolab.example>"
# Where new-booking / new-quote alerts go
SHOP_NOTIFICATION_EMAIL="owner@autolab.example"

# ── SMS (Twilio). Without these, texts are only logged. ─────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+15550000000"
